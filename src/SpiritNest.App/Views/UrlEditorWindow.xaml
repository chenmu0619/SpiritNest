<Window x:Class="SpiritNest.Views.UrlEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加网址"
        Width="640" Height="360"
        MinWidth="520" MinHeight="240"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="False"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FF1A2420"/>
        <SolidColorBrush x:Key="Muted" Color="#FF6B7A72"/>
        <SolidColorBrush x:Key="Line" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="Hover" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="Press" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryFill" Color="#66E8ECE9"/>

        <Style x:Key="FlatDlgBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Press}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatIconBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fill matches panel; round silhouette from shared Win32 region on glass + content -->
    <Border x:Name="RootBg"
            Background="#55F5F7F6"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="False"
            Padding="14,12">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconBtn}"
                        FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Content="&#xE8BB;" ToolTip="关闭" Click="Cancel_Click"/>
                <TextBlock x:Name="TitleText" Text="添加网址"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="AddRowBtn" Content="添加一行" Style="{StaticResource FlatDlgBtn}"
                        Margin="0,0,8,0" Click="AddRow_Click"/>
                <Button Content="确定" IsDefault="True" Style="{StaticResource FlatDlgBtn}"
                        Background="{StaticResource PrimaryFill}" FontWeight="SemiBold"
                        Margin="0,0,8,0" Click="Ok_Click"/>
                <Button Content="取消" IsCancel="True" Style="{StaticResource FlatDlgBtn}"
                        Click="Cancel_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          Padding="0,2">
                <StackPanel x:Name="RowsHost"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
