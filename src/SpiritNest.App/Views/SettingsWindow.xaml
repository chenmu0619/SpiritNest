<Window x:Class="SpiritNest.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵栖设置"
        Width="700" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="Muted" Color="#FF8A8A8A"/>
        <SolidColorBrush x:Key="Line" Color="#14000000"/>
        <SolidColorBrush x:Key="Hover" Color="#0A000000"/>
        <SolidColorBrush x:Key="FieldBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PageBg" Color="#FFF2F2F7"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SwitchOn" Color="#FF34C759"/>
        <SolidColorBrush x:Key="SwitchOff" Color="#FFE5E5EA"/>
        <SolidColorBrush x:Key="NavActive" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4F9DFF"/>

        <!-- Left nav — iOS Settings–style list -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActive}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox → mobile toggle switch (label left, track right) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <Border x:Name="Track" Grid.Column="1"
                                        Width="46" Height="28" CornerRadius="14"
                                        Background="{DynamicResource SwitchOff}"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Ellipse x:Name="Thumb" Width="24" Height="24"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             Margin="2,0,2,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchOn}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                BorderThickness="1.5" BorderBrush="#FF8E8E93"
                                Background="Transparent" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Mark" Text="✓" FontSize="11" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,-1,0,0"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF4F9DFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF4F9DFF"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact switch for list trailing controls (no stretch row chrome) -->
        <Style x:Key="InlineSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Cursor="Hand" Padding="4">
                            <Border x:Name="Track" Width="46" Height="28" CornerRadius="14"
                                    Background="{DynamicResource SwitchOff}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,2,0"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchOn}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="16,14,16,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="Hairline" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
        </Style>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFFF3B30" BorderThickness="0"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE0352B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Margin="4,0" Padding="10,8" MinWidth="148">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PageBg}"/>
            <Setter Property="BorderBrush" Value="#1A000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="MenuChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="PasswordChar" Value="*"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellRoot" CornerRadius="16" BorderThickness="1" ClipToBounds="True"
            Background="#FFF2F2F7" BorderBrush="#1A000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Margin="20,14,12,10">
                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Content="✕" Width="32" Height="28"
                        Style="{StaticResource GhostBtn}" FontSize="14" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="12,0,12,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="#18000000" CornerRadius="14" Padding="6" Margin="0,0,10,0">
                    <StackPanel>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavBtn}" Content="通用"
                                     GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPages" Style="{StaticResource NavBtn}" Content="页面管理"
                                     GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSearch" Style="{StaticResource NavBtn}" Content="天气和搜索"
                                     GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <Border Height="1" Background="{DynamicResource Line}" Margin="10,10,10,8"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavBtn}" Content="关于"
                                     GroupName="SettingsNav" Checked="Nav_Checked"/>
                    </StackPanel>
                </Border>

                <!-- General -->
                <ScrollViewer x:Name="PageGeneral" Grid.Column="1"
                              VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="启动与显示" Margin="16,4,16,6"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutostart" Content="开机启动"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <Border Style="{StaticResource Hairline}"/>
                                <CheckBox x:Name="ChkMinimal" Content="极简模式"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <Border Style="{StaticResource Hairline}"/>
                                <CheckBox x:Name="ChkBrowserMinimal" Content="浏览器极简"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <Border Style="{StaticResource Hairline}"/>
                                <CheckBox x:Name="ChkHideFullscreen" Content="全屏时隐藏"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <Border Style="{StaticResource Hairline}"/>
                                <CheckBox x:Name="ChkThisPc" Content="此电脑"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <Border Style="{StaticResource Hairline}"/>
                                <CheckBox x:Name="ChkRecycle" Content="回收站"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="过渡动画时长" VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource Ink}"/>
                                    <Slider x:Name="AnimDurationSlider" Grid.Column="1"
                                            Minimum="100" Maximum="2000" TickFrequency="50"
                                            SmallChange="50" LargeChange="50"
                                            IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            Margin="12,0" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="AnimDurationSlider_PreviewMouseLeftButtonDown"
                                            ValueChanged="AnimDuration_Changed"/>
                                    <TextBlock x:Name="AnimDurationLabel" Grid.Column="2"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}"
                                               MinWidth="64" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pages -->
                <Grid x:Name="PagePages" Grid.Column="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="页面管理"
                               Margin="16,4,16,6"/>
                    <Border Grid.Row="1" Style="{StaticResource GroupCard}" Margin="0" Padding="0">
                        <ScrollViewer x:Name="PageScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="None"
                                      PreviewMouseMove="PageScroll_MouseMove"
                                      PreviewMouseLeftButtonUp="PageScroll_MouseUp"
                                      LostMouseCapture="PageScroll_LostCapture">
                            <StackPanel x:Name="PageListHost"/>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,12,0,0">
                        <Button Style="{StaticResource FlatBtn}" Content="添加页面" Click="CatAdd_Click"/>
                        <Button x:Name="PageDeleteBtn" Style="{StaticResource FlatBtn}" Content="删除"
                                Click="PageDelete_Click"/>
                        <Button x:Name="PageDeleteCancelBtn" Style="{StaticResource FlatBtn}" Content="取消删除"
                                Visibility="Collapsed" Click="PageDeleteCancel_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Search / weather -->
                <ScrollViewer x:Name="PageSearch" Grid.Column="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="天气" Margin="16,4,16,6"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <CheckBox x:Name="ChkWeather" Content="显示天气"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="位置" Margin="14,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource Ink}"/>
                                    <TextBox x:Name="PlaceSearch" Grid.Column="1"
                                             Style="{StaticResource FieldBox}"
                                             Margin="16,0,4,0"
                                             VerticalAlignment="Center"
                                             TextAlignment="Right"
                                             Background="{DynamicResource FieldBg}"
                                             GotFocus="PlaceSearch_GotFocus"
                                             TextChanged="PlaceSearch_TextChanged"
                                             LostFocus="PlaceSearch_LostFocus"/>
                                    <Button x:Name="PlaceLocateBtn" Grid.Column="2"
                                            Width="28" Height="28" Margin="0,0,8,0" Padding="0"
                                            ToolTip="定位" Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Click="PlaceLocate_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        <TextBlock x:Name="PlaceLocateIcon" Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{DynamicResource Ink}">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>
                                    <ListBox x:Name="PlaceList" Grid.Row="1" Grid.Column="1"
                                             Margin="16,0,4,8"
                                             MaxHeight="164"
                                             Padding="0"
                                             Visibility="Collapsed"
                                             BorderThickness="1"
                                             BorderBrush="{DynamicResource Line}"
                                             Background="{DynamicResource FieldBg}"
                                             Foreground="{DynamicResource Ink}"
                                             FontSize="13"
                                             DisplayMemberPath="Label"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             PreviewMouseLeftButtonDown="PlaceList_PreviewMouseDown"
                                             MouseLeftButtonUp="PlaceList_Click"
                                             LostKeyboardFocus="PlaceList_LostFocus">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Height" Value="32"/>
                                                <Setter Property="Padding" Value="12,0"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="高德 Key" Margin="14,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource Ink}"/>
                                    <Grid Grid.Column="1" Margin="16,0,4,0" VerticalAlignment="Center">
                                        <PasswordBox x:Name="AmapKeyPassword"
                                                     Style="{StaticResource FieldPassword}"
                                                     Background="{DynamicResource FieldBg}"
                                                     ToolTip="用于 IP 定位。Key 的服务平台请选择「Web服务」。填写后，自动定位优先使用高德。"
                                                     LostFocus="AmapKey_LostFocus"
                                                     KeyDown="AmapKey_KeyDown"/>
                                        <TextBox x:Name="AmapKeyBox"
                                                 Style="{StaticResource FieldBox}"
                                                 Visibility="Collapsed"
                                                 Background="{DynamicResource FieldBg}"
                                                 ToolTip="用于 IP 定位。Key 的服务平台请选择「Web服务」。填写后，自动定位优先使用高德。"
                                                 LostFocus="AmapKey_LostFocus"
                                                 KeyDown="AmapKey_KeyDown"/>
                                    </Grid>
                                    <Button x:Name="AmapKeyToggleBtn" Grid.Column="2"
                                            Width="28" Height="28" Margin="0,0,8,0" Padding="0"
                                            ToolTip="显示" Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Click="AmapKeyToggle_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock x:Name="AmapKeyToggleIcon" Text="&#xE890;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Ink}"/>
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                               Text="用于 IP 定位。Key 的服务平台请选择「Web服务」。"
                                               FontSize="12" Margin="14,0,12,10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Muted}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="默认浏览器"/>
                        <Border Style="{StaticResource GroupCard}" Padding="4,2,4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BrowserPathBox" Style="{StaticResource FieldBox}"
                                         ToolTip="空 = 系统默认浏览器"
                                         LostFocus="Setting_Changed" KeyDown="Browser_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="浏览"
                                        Margin="0,0,6,0" VerticalAlignment="Center"
                                        Click="BrowseBrowser_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="搜索引擎"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel x:Name="EngineListHost"
                                        PreviewMouseMove="EngineList_MouseMove"
                                        PreviewMouseLeftButtonUp="EngineList_MouseUp"
                                        LostMouseCapture="EngineList_LostCapture"/>
                        </Border>
                        <Button Style="{StaticResource FlatBtn}" Content="添加引擎"
                                HorizontalAlignment="Left" Margin="4,12,0,0"
                                Click="EngineAdd_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer x:Name="PageAbout" Grid.Column="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="应用" Margin="16,4,16,6"/>
                        <Border Style="{StaticResource GroupCard}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="灵栖" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink}"/>
                                <TextBlock x:Name="VersionText" FontSize="13" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="LocationSourceText" FontSize="12"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text="天气数据来自 Open-Meteo" FontSize="12"
                                           Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text="天气图标 © 和风天气 QWeather Icons" FontSize="12"
                                           Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="安装"/>
                        <Border Style="{StaticResource GroupCard}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="安装目录" FontSize="12"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="InstallPathText" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,6,0,12" Foreground="{DynamicResource Ink}"/>
                                <Button Style="{StaticResource FlatBtn}" Content="打开安装目录"
                                        HorizontalAlignment="Left" Margin="0"
                                        Click="OpenInstall_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="数据"/>
                        <Border Style="{StaticResource GroupCard}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="数据目录" FontSize="12"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="DataPathText" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,6,0,12" Foreground="{DynamicResource Ink}"/>
                                <Button Style="{StaticResource FlatBtn}" Content="打开数据文件夹"
                                        HorizontalAlignment="Left" Margin="0"
                                        Click="OpenData_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
