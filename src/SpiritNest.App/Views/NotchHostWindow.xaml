<Window x:Class="SpiritNest.Views.NotchHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵栖"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Width="136" Height="28"
        MouseEnter="Host_MouseEnter"
        MouseLeave="Host_MouseLeave"
        MouseMove="Host_MouseMove"
        SourceInitialized="Host_SourceInitialized"
        SizeChanged="Host_SizeChanged">
    <Window.Resources>
        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFF5F2EC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular pager — vertically centered in icon area; Path chevron for true center -->
        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFF5F2EC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12"
                                Background="#22FFFFFF" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Explicit W/H (not Window size / Scale) so X and Y share one progress clock -->
    <Border x:Name="Shell"
            CornerRadius="0,0,14,14"
            BorderThickness="0"
            ClipToBounds="False"
            SnapsToDevicePixels="False"
            Background="#FF000000"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="136" Height="28"
            SizeChanged="Shell_SizeChanged">
        <Grid>
            <!-- Home bar visual (shell is taller to include top gap as hit area) -->
            <Border x:Name="MinimalLine"
                    Width="128" Height="5"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    CornerRadius="2.5"
                    Background="#FF1C1C1C"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

            <!-- Collapsed: normal notch — equal side columns keep eyes geometrically centered -->
            <Grid x:Name="NotchView" Margin="8,0" Height="28" VerticalAlignment="Top" Visibility="Visible" Opacity="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NotchTemp" Grid.Column="0"
                           Text="--" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="0,0,4,0" TextAlignment="Left"
                           Foreground="#F5F2EC"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Perfect circle white eyes; digits translate inside -->
                    <Border x:Name="LeftEye" Width="18" Height="18" CornerRadius="9"
                            Background="#FFFFF8F0" Margin="0,0,5,0" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <TextBlock x:Name="HourText" Text="12" FontSize="8" FontWeight="Bold"
                                       Foreground="#000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="HourTx"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <Border x:Name="LeftLid" Background="#FF000000" Height="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <Border x:Name="RightEye" Width="18" Height="18" CornerRadius="9"
                            Background="#FFFFF8F0" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <TextBlock x:Name="MinuteText" Text="00" FontSize="8" FontWeight="Bold"
                                       Foreground="#000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="MinuteTx"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <Border x:Name="RightLid" Background="#FF000000" Height="0"
                                    VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <!-- Glyph only — flush right; temp flush left; eyes stay centered -->
                <TextBlock x:Name="NotchWeather" Grid.Column="2"
                           Text="&#xf102;" FontSize="13"
                           FontFamily="{StaticResource QWeather}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="4,0,0,0" TextAlignment="Right"
                           Foreground="#F5F2EC"/>
            </Grid>

            <!-- Panel at full size; Shell clips it — scroll/unroll reveal, never scale content -->
            <Viewbox x:Name="PanelView"
                     Stretch="None"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Visibility="Collapsed">
                <Grid x:Name="PanelRoot" Width="444" Height="192" Background="Transparent">
                <Grid Margin="8,4,8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header (compact) -->
                <Grid Grid.Row="0" Margin="0,0,0,4" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Text="灵栖" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#F5F2EC"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="HeaderBackBtn" Grid.Column="1" Style="{StaticResource ChromeBtn}"
                            ToolTip="返回" Click="BackFromSub_Click" Margin="0,0,2,0"
                            Padding="6,0" Height="24" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <!-- Path chevron: geometrically centered, avoids glyph baseline drift -->
                        <Viewbox Width="7" Height="10" Stretch="Uniform">
                            <Path Fill="#F5F2EC"
                                  Data="M 10,0 L 2,7 L 10,14 L 8.2,14 L 0.2,7 L 8.2,0 Z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="HeaderSearchBtn" Grid.Column="2" Style="{StaticResource ChromeBtn}"
                            Content="⌕" FontSize="14" ToolTip="搜索" Foreground="#FFF5F2EC"
                            Click="SearchBtn_Click" Margin="2,0"/>
                    <Button x:Name="HeaderWeatherBtn" Grid.Column="3" Style="{StaticResource ChromeBtn}"
                            Click="WeatherBtn_Click" Margin="0" ToolTip="天气" Foreground="#FFF5F2EC">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderWeatherIcon" Text="&#xf102;" FontSize="13"
                                       FontFamily="{StaticResource QWeather}"
                                       VerticalAlignment="Center" Foreground="#F5F2EC"/>
                            <TextBlock x:Name="HeaderWeatherText" Text=" --°" FontSize="11"
                                       VerticalAlignment="Center" Margin="3,0,0,0"
                                       Foreground="#F5F2EC"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HeaderDateTime" Grid.Column="4"
                               Text="" FontSize="10" VerticalAlignment="Center"
                               Margin="6,0" Foreground="#A8A096"/>
                    <Button x:Name="HeaderSettingsBtn" Grid.Column="5" Style="{StaticResource ChromeBtn}"
                            Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="13" ToolTip="设置" Foreground="#FFF5F2EC"
                            Click="SettingsBtn_Click"/>
                </Grid>

                <!-- Per-tab icons: 6 cols × 2 visible rows; overflow = wheel; dots switch tabs -->
                <Grid x:Name="IconsView" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Column="0" Grid.Row="0" Style="{StaticResource PagerBtn}"
                            Click="PrevPage_Click" ToolTip="上一页">
                        <Viewbox Width="6" Height="9" Stretch="Uniform">
                            <Path Fill="#F5F2EC"
                                  Data="M 10,0 L 2,7 L 10,14 L 7.8,14 L 0,7 L 7.8,0 Z"/>
                        </Viewbox>
                    </Button>
                    <ScrollViewer x:Name="IconScroll" Grid.Column="1" Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly"
                                  Focusable="False">
                        <ItemsControl x:Name="IconGrid" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" Rows="0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Icon_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Margin="2" Padding="0"
                                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                            ToolTip="{Binding BrokenTip}"
                                            IsEnabled="{Binding CanInteract}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Ib" Background="Transparent" CornerRadius="8" Padding="2">
                                                    <StackPanel>
                                                        <Grid Width="36" Height="36" HorizontalAlignment="Center">
                                                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                                                   Opacity="{Binding ContentOpacity}"
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Ellipse Width="20" Height="20"
                                                                     Stroke="#F5F2EC" StrokeThickness="2"
                                                                     StrokeDashArray="2.2 1.6"
                                                                     StrokeDashCap="Round"
                                                                     RenderTransformOrigin="0.5,0.5"
                                                                     IsHitTestVisible="False">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                                <Ellipse.RenderTransform>
                                                                    <RotateTransform/>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation
                                                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                    From="0" To="360" Duration="0:0:0.8"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>
                                                            <Border Width="26" Height="12" CornerRadius="3"
                                                                    Background="#CCE05C5C" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Right" Margin="0,0,-2,-2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="失效" FontSize="7" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="64" Margin="0,1,0,0"
                                                                   Opacity="{Binding ContentOpacity}"
                                                                   Foreground="#ECEEF2"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsEnabled" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Ib" Property="Background" Value="#28FFFFFF"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Column="2" Grid.Row="0" Style="{StaticResource PagerBtn}"
                            Click="NextPage_Click" ToolTip="下一页">
                        <Viewbox Width="6" Height="9" Stretch="Uniform">
                            <Path Fill="#F5F2EC"
                                  Data="M 0,0 L 8,7 L 0,14 L 2.2,14 L 10,7 L 2.2,0 Z"/>
                        </Viewbox>
                    </Button>
                    <StackPanel x:Name="PageDots" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <!-- Search subview (height driven by content) -->
                <Border x:Name="SearchView" Grid.Row="1" Visibility="Collapsed"
                        CornerRadius="10" BorderThickness="1" BorderBrush="#40FFFFFF"
                        Background="#22000000" Padding="6" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EngineBtn" Style="{StaticResource ChromeBtn}"
                                Click="EngineBtn_Click" Margin="0,0,4,0" ToolTip="搜索引擎">
                            <Image x:Name="EngineIcon" Width="18" Height="18"/>
                        </Button>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 FontSize="14" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="4,6"
                                 Foreground="#F5F2EC" CaretBrush="#F5F2EC"
                                 KeyDown="SearchBox_KeyDown"/>
                    </Grid>
                </Border>

                <!-- Weather subview：今日摘要 + 未来 6 日 -->
                <Grid x:Name="WeatherView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                            <TextBlock x:Name="WeatherNowIcon"
                                       FontFamily="{StaticResource QWeather}"
                                       FontSize="32" Margin="0,0,8,0"
                                       Foreground="#F5F2EC"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeatherNow"
                                       FontSize="32" FontWeight="SemiBold"
                                       Foreground="#F5F2EC"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WeatherRange"
                                       FontSize="22" Foreground="#D8D0C6"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WeatherCity"
                                       FontSize="13" Foreground="#A8A096"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WeatherRefreshed"
                                       FontSize="13" Foreground="#A8A096"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="WeatherRefreshBtn" Grid.Column="1"
                                Style="{StaticResource ChromeBtn}"
                                ToolTip="刷新" Click="WeatherRefresh_Click"
                                Padding="8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="WeatherRefreshIcon" Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       RenderTransformOrigin="0.5,0.5"
                                       Foreground="#F5F2EC">
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <ItemsControl x:Name="ForecastList" Grid.Row="1" Margin="0,0,0,2"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DayLabel}" FontSize="11"
                                               HorizontalAlignment="Center" Foreground="#A8A096"/>
                                    <TextBlock Text="{Binding WeatherGlyph}" FontSize="18"
                                               FontFamily="{StaticResource QWeather}"
                                               HorizontalAlignment="Center" Margin="0,3,0,1"
                                               Foreground="#F5F2EC"/>
                                    <TextBlock Text="{Binding WeatherText}" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="#D8D0C6"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding TempLabel}" FontSize="10"
                                               HorizontalAlignment="Center" Foreground="#F5F2EC"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</Window>
